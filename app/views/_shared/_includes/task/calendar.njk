<div class="cal-wrapper" role="region" aria-label="Case calendar" data-module="cal-calendar">

  {# ── Header ── #}
  <div class="cal-header">
    <h2 id="cal-heading" class="cal-heading">{{ calendarMonthName }}</h2>
    <div class="cal-controls">

      <nav class="cal-nav" aria-label="Calendar navigation">
        <a href="#" class="cal-nav-btn" aria-label="Previous month">&#8249;</a>
        <a href="#" class="cal-nav-btn" aria-label="Next month">&#8250;</a>
      </nav>

      <div class="cal-view-switcher" role="group" aria-label="Calendar view">
        <a href="#" class="cal-view-btn cal-view-btn--active" aria-current="true">Month</a>
        <a href="#" class="cal-view-btn">Week</a>
        <a href="#" class="cal-view-btn">Work week</a>
        <a href="#" class="cal-view-btn">Day</a>
      </div>

      <a href="#" class="cal-today-btn">Today</a>

    </div>
  </div>

  {# ── Legend ── #}
  <ul class="cal-legend" aria-label="Event type legend">
    {% for type in eventTypes %}
    <li class="cal-legend-item">
      <span class="cal-legend-dot cal-legend-dot--{{ type.key }}" aria-hidden="true"></span>
      <span>{{ type.label }}</span>
    </li>
    {% endfor %}
  </ul>

  {# ── Grid (desktop) ── #}
  <div class="cal-grid-container">
    <table class="cal-grid" role="grid" aria-labelledby="cal-heading">
      <thead>
        <tr role="row">
          <th role="columnheader" scope="col" abbr="Monday">Monday</th>
          <th role="columnheader" scope="col" abbr="Tuesday">Tuesday</th>
          <th role="columnheader" scope="col" abbr="Wednesday">Wednesday</th>
          <th role="columnheader" scope="col" abbr="Thursday">Thursday</th>
          <th role="columnheader" scope="col" abbr="Friday">Friday</th>
        </tr>
      </thead>
      <tbody>
        {% for week in calendarGrid %}
        <tr role="row">
          {% for cell in week %}
          {% if cell.date %}
          <td class="cal-cell{% if cell.isToday %} cal-cell--today{% endif %}"
              role="gridcell"
              aria-label="{{ cell.dayNumber }} {{ calendarMonthName }}{% if cell.isToday %}, today{% endif %}">
            <span class="cal-date" aria-hidden="true">{{ cell.dayNumber }}</span>
            {% if cell.events.length %}
            <ul class="cal-events" aria-label="Events on {{ cell.dayNumber }} {{ calendarMonthName }}">
              {% for ev in cell.events %}
              <li class="cal-event cal-event--{{ ev.type }}">
                <span class="cal-event__count" aria-hidden="true">{{ ev.count }}</span>
                <span>{{ ev.label }}</span>
              </li>
              {% endfor %}
            </ul>
            {% endif %}
          </td>
          {% else %}
          <td class="cal-cell cal-cell--empty" role="gridcell" aria-label="No date"></td>
          {% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Agenda (mobile) ── #}
  <div class="cal-agenda" aria-label="Events for {{ calendarMonthName }}">
    {% for day in calendarAgenda %}
    <div class="cal-agenda-day{% if day.isToday %} cal-agenda-day--today{% endif %}">
      <div class="cal-agenda-date">
        {{ day.dayNumber }} {{ calendarMonthName }}{% if day.isToday %} (Today){% endif %}
      </div>
      <ul class="cal-agenda-events">
        {% for ev in day.events %}
        <li class="cal-agenda-event cal-agenda-event--{{ ev.type }}">
          <strong>{{ ev.count }}</strong> {{ ev.label }}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>

</div>{# /cal-wrapper #}
