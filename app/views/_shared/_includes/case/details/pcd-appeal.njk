{# _shared/_includes/case/details/pcd-appeal.njk

   PCD (Post-Charge Decision) appeal summary card for the case overview —
   sits in the contacts-box column, above Key contacts (see main-tabs.njk).
   Static mock content for now, keyed by caseId in
   app/data/pcd-appeal-cases.js (no Prisma model for appeal content yet).
   Only rendered when pcdAppeal is set (case--details.js).

   Default state (no decision yet) shows only the appeal details — that's
   the fact this card exists to surface ("police have challenged this"),
   not a replay of a decision the CPS side already knows it made. The
   original charging decision only becomes relevant again once there's a
   record to read back, so it appears — for the first time on this card —
   once a decision is recorded, ahead of Appeal and Decision, in
   chronological order. Start task is not on this card: the police appeal
   is what generates the task in the main task list, so that's where the
   journey starts.

   Once a decision is submitted (POST /cases/:caseId/pcd-appeal/decision
   mutates the in-memory mock record), this same card grows in place to
   show the full record — one card throughout, not a second one appended
   alongside it.
#}

<div class="govuk-summary-card app-pcd-appeal">
  <div class="govuk-summary-card__title-wrapper">
    <h2 class="govuk-summary-card__title">
      PCD appeal
      {% if pcdAppeal.taskType == 'PCD Appeal (Red)' %}
        {{ govukTag({ text: "Priority", classes: "govuk-tag--red" }) }}
      {% else %}
        {{ govukTag({ text: "Review", classes: "govuk-tag--green" }) }}
      {% endif %}
    </h2>
  </div>

  <div class="govuk-summary-card__content">

    {% if pcdAppeal.dcpDecision %}

      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Previous charging details</h3>
      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border app-summary-list--compact",
        rows: [
          { key: { text: "Reviewing prosecutor" }, value: { text: pcdAppeal.originalDecision.prosecutor } },
          { key: { text: "Decision" }, value: { text: pcdAppeal.originalDecision.decision } },
          { key: { text: "Date/time" }, value: { text: pcdAppeal.originalDecision.decisionDateDisplay } },
          { key: { text: "Test applied" }, value: { text: pcdAppeal.originalDecision.test } }
        ]
      }) }}

      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Appeal</h3>
      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border app-summary-list--compact",
        rows: [
          { key: { text: "Appealing officer" }, value: { text: pcdAppeal.appeal.appealingOfficer.name + " (" + pcdAppeal.appeal.appealingOfficer.rank + ", " + pcdAppeal.appeal.appealingOfficer.number + ")" } },
          {
            key: { text: "Officer in charge" },
            value: { text: (pcdAppeal.appeal.oic.name + " (" + pcdAppeal.appeal.oic.rank + ", " + pcdAppeal.appeal.oic.number + ")") if pcdAppeal.appeal.oic else "Same as appealing officer" }
          },
          { key: { text: "Date/time received" }, value: { text: pcdAppeal.appeal.receivedDateDisplay } },
          { key: { text: "Grounds for appeal" }, value: { text: pcdAppeal.appeal.groundsNarrative } },
          { key: { text: "Evidence referenced" }, value: { html: pcdAppeal.appeal.evidenceRefs | join('<br>') } }
        ]
      }) }}

      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Decision</h3>
      {% set chargeOutcomeRows = [] %}
      {% for outcome in pcdAppeal.dcpDecision.chargeOutcomes %}
        {% set chargeOutcomeRows = (chargeOutcomeRows.push({ key: { text: outcome.code }, value: { text: outcome.outcome } }), chargeOutcomeRows) %}
      {% endfor %}

      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border app-summary-list--compact",
        rows: chargeOutcomeRows.concat([
          { key: { text: "Test applied" }, value: { text: pcdAppeal.dcpDecision.testApplied } },
          { key: { text: "Reasoning" }, value: { text: pcdAppeal.dcpDecision.reasoning } },
          { key: { text: "Decided by" }, value: { text: pcdAppeal.dcpDecision.decidedBy } },
          { key: { text: "Decided on" }, value: { text: pcdAppeal.dcpDecision.decidedDateDisplay } }
        ])
      }) }}

      {{ govukInsetText({
        text: "This decision has been recorded. A formal MG3A-equivalent document and notification back to police still need to be sent outside this prototype."
      }) }}

    {% else %}

      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border app-summary-list--compact",
        rows: [
          { key: { text: "Appealing officer" }, value: { text: pcdAppeal.appeal.appealingOfficer.name + " (" + pcdAppeal.appeal.appealingOfficer.rank + ", " + pcdAppeal.appeal.appealingOfficer.number + ")" } },
          {
            key: { text: "Officer in charge" },
            value: { text: (pcdAppeal.appeal.oic.name + " (" + pcdAppeal.appeal.oic.rank + ", " + pcdAppeal.appeal.oic.number + ")") if pcdAppeal.appeal.oic else "Same as appealing officer" }
          },
          { key: { text: "Date/time received" }, value: { text: pcdAppeal.appeal.receivedDateDisplay } },
          { key: { text: "Grounds for appeal" }, value: { text: pcdAppeal.appeal.groundsNarrative } },
          { key: { text: "Evidence referenced" }, value: { html: pcdAppeal.appeal.evidenceRefs | join('<br>') } }
        ]
      }) }}

    {% endif %}

  </div>
</div>
