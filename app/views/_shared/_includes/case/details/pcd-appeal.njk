{# _shared/_includes/case/details/pcd-appeal.njk

   PCD (Post-Charge Decision) appeal summary card for the case overview —
   sits in the contacts-box column, above Key contacts (see main-tabs.njk).
   Real Prisma data (PcdAppeal/PcdAppealCharge models), fetched by
   getPcdAppealForCase (app/helpers/pcdAppeal.js) and reshaped into this
   same object shape the old app/data/pcd-appeal-cases.js mock used.
   Only rendered when pcdAppeal is set (case--details.js).

   Kept deliberately concise — Authorised by, Date and time received,
   Date and time decision made, Appealed suspect and Reason for appeal
   only, in both states.
   "Previous charging details" no longer lives on this
   card at all: it's shown on cases/pcd-appeal/decision.html, and
   permanently in the History tab (history-panel.njk) so it can be seen
   before a PCD review task is even started. Start task is not on this
   card either: the police appeal is what generates the task in the main
   task list, so that's where the journey starts.

   Once a decision is submitted (POST /cases/:caseId/pcd-appeal/decision
   writes the real PcdAppeal/PcdAppealCharge rows), this same card grows
   in place to add the Decision section — one card throughout, not a
   second one appended alongside it.
#}

<div class="govuk-summary-card app-pcd-appeal">
  <div class="govuk-summary-card__title-wrapper">
    <h2 class="govuk-summary-card__title">
      Review PCD Appeal
      {% if pcdAppeal.taskType == 'Priority PCD Review' %}
        {{ govukTag({ text: "Priority", classes: "govuk-tag--red" }) }}
      {% endif %}
    </h2>
  </div>

  <div class="govuk-summary-card__content">

    {% if pcdAppeal.dcpDecision %}

      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Appeal</h3>
      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border app-summary-list--compact",
        rows: [
          { key: { text: "Authorised by" }, value: { text: pcdAppeal.appeal.appealingOfficer.name + " (" + pcdAppeal.appeal.appealingOfficer.rank + ", " + pcdAppeal.appeal.appealingOfficer.number + ")" } },
          { key: { text: "Date and time received" }, value: { text: pcdAppeal.appeal.receivedDateDisplay | isoDateString | govukDateTime } },
          { key: { text: "Date and time decision made" }, value: { text: pcdAppeal.originalDecision.decisionDateDisplay | isoDateString | govukDateTime } },
          { key: { text: "Appealed suspect" }, value: { text: pcdAppeal.suspects | join(', ') } },
          { key: { text: "Reason for appeal" }, value: { text: pcdAppeal.appeal.groundsNarrative } }
        ]
      }) }}

      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Decision</h3>
      {% set chargeOutcomeRows = [] %}
      {% for outcome in pcdAppeal.dcpDecision.chargeOutcomes %}
        {% set chargeOutcomeRows = (chargeOutcomeRows.push({ key: { text: outcome.code }, value: { text: outcome.outcome } }), chargeOutcomeRows) %}
      {% endfor %}

      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border app-summary-list--compact",
        rows: chargeOutcomeRows.concat([
          { key: { text: "Test applied" }, value: { text: pcdAppeal.dcpDecision.testApplied } },
          { key: { text: "Reasoning" }, value: { text: pcdAppeal.dcpDecision.reasoning } },
          { key: { text: "Decided by" }, value: { text: pcdAppeal.dcpDecision.decidedBy } },
          { key: { text: "Decided on" }, value: { text: pcdAppeal.dcpDecision.decidedDateDisplay | isoDateString | govukDateTime } }
        ])
      }) }}

      {{ govukInsetText({
        text: "This decision has been recorded. A formal MG3A-equivalent document and notification back to police still need to be sent outside this prototype."
      }) }}

    {% else %}

      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border app-summary-list--compact",
        rows: [
          { key: { text: "Authorised by" }, value: { text: pcdAppeal.appeal.appealingOfficer.name + " (" + pcdAppeal.appeal.appealingOfficer.rank + ", " + pcdAppeal.appeal.appealingOfficer.number + ")" } },
          { key: { text: "Date and time received" }, value: { text: pcdAppeal.appeal.receivedDateDisplay | isoDateString | govukDateTime } },
          { key: { text: "Date and time decision made" }, value: { text: pcdAppeal.originalDecision.decisionDateDisplay | isoDateString | govukDateTime } },
          { key: { text: "Appealed suspect" }, value: { text: pcdAppeal.suspects | join(', ') } },
          { key: { text: "Reason for appeal" }, value: { text: pcdAppeal.appeal.groundsNarrative } }
        ]
      }) }}

    {% endif %}

  </div>
</div>
