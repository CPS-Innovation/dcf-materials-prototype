{# _shared/_includes/case/details/history-panel.njk

   Moved out of the Outline tab's "Confidential Information to Prosecutor"
   section per stakeholder feedback — showing the unredacted original text
   there was misleading and the wrong placement. Lives in its own "History"
   tab instead (see main-tabs.njk).

   Renders the full version-by-version audit trail (factualSummaryVersions
   — see recordFactualSummaryVersion in case--outline.js), not just the
   original wording: a new row is appended every time a redaction or edit
   is committed, capturing what the text was immediately before that
   commit, newest first. Nothing shows until the first commit ever
   happens, same as before. Wrapped in its own two-thirds column here
   (unlike outline-panels.njk's cards, which wrap themselves) since this
   partial owns its whole tab panel. #}
{# ---------------------------------------------------------------------
   Previous charging decision (PCD appeal) — permanent part of the audit
   trail, not tied to whether a decision has been made yet, so it can be
   seen from History before a PCD review task is even started. Real
   Prisma data (PcdAppeal model), fetched by getPcdAppealForCase
   (app/helpers/pcdAppeal.js). "Investigation stage"/"Action plan"/
   "Specified charges"/"PCD principal offence category" are still
   placeholder text pending real fields from the database team; "Suspect
   name"/"Reason for decision" are real (case defendant / original
   decision reasoning).
   --------------------------------------------------------------------- #}
{% if pcdAppeal %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Previous charging decision</h2>
        </div>
        <div class="govuk-summary-card__content">

          {{ govukSummaryList({
            attributes: { style: "border-bottom: 1px solid #b1b4b6" },
            rows: [
              { key: { text: "Date decision requested" }, value: { text: pcdAppeal.originalDecision.decisionDateDisplay | isoDateString | govukDate } },
              { key: { text: "Decision made by" }, value: { text: pcdAppeal.originalDecision.prosecutor } },
              { key: { text: "Decision" }, value: { text: pcdAppeal.originalDecision.decision } },
              { key: { text: "Date and time decision made" }, value: { text: pcdAppeal.originalDecision.decisionDateDisplay | isoDateString | govukDateTime } },
              { key: { text: "Test applied" }, value: { text: pcdAppeal.originalDecision.test } },
              { key: { text: "Investigation stage" }, value: { text: pcdAppeal.investigationStage } },
              { key: { text: "Action plan" }, value: { text: pcdAppeal.actionPlan } },
              { key: { text: "Suspect name" }, value: { text: pcdAppeal.suspects | join(', ') } },
              { key: { text: "Reason for decision" }, value: { text: pcdAppeal.originalDecision.reasoning } },
              { key: { text: "Specified charges" }, value: { text: pcdAppeal.specifiedCharges } },
              { key: { text: "PCD principal offence category" }, value: { text: pcdAppeal.pcdPrincipalOffenceCategory } }
            ]
          }) }}

        </div>
      </div>
    </div>
  </div>
{% endif %}

{% if _case.factualSummaryVersions and _case.factualSummaryVersions.length %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set versionRows = [] %}
      {% for version in _case.factualSummaryVersions %}
        {# redactionEditDisplay, called without an "original" to diff
           against, just bolds any "[Redacted <type>]" text it finds and
           splits into <p> paragraphs — same treatment the live Outline
           card gives the current version, applied here to each past one
           too, so redactions stay discoverable at a glance. #}
        {% set actionLabel = "Redacted on " if version.action == 'redacted' else "Edited on " %}
        {% set byLabel = " by " + version.userName if version.action == 'redacted' and version.userName else "" %}
        {% set versionRows = (versionRows.push({
          key: { text: actionLabel + (version.createdAt | govukDate) + byLabel },
          value: { html: version.text | redactionEditDisplay | safe }
        }), versionRows) %}
      {% endfor %}

      {{ govukSummaryList({
        card: {
          title: {
            html: 'Summary of circumstances of offence(s) (previous versions)'
          }
        },
        rows: versionRows
      }) }}

    </div>
  </div>
{% endif %}

{# Mirrors the Summary of circumstances block above exactly, for Arrest
   details' own version history (arrestDetailsVersions — see
   recordFieldVersion in case--outline.js). #}
{% if _case.arrestDetailsVersions and _case.arrestDetailsVersions.length %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set arrestVersionRows = [] %}
      {% for version in _case.arrestDetailsVersions %}
        {% set actionLabel = "Redacted on " if version.action == 'redacted' else "Edited on " %}
        {% set byLabel = " by " + version.userName if version.action == 'redacted' and version.userName else "" %}
        {% set arrestVersionRows = (arrestVersionRows.push({
          key: { text: actionLabel + (version.createdAt | govukDate) + byLabel },
          value: { html: version.text | redactionEditDisplay | safe }
        }), arrestVersionRows) %}
      {% endfor %}

      {{ govukSummaryList({
        card: {
          title: {
            html: 'Arrest details (previous versions)'
          }
        },
        rows: arrestVersionRows
      }) }}

    </div>
  </div>
{% endif %}
