{# _shared/_includes/case/details/main-tabs.njk #}

{# ---------- Overview tab ---------- #}
{% set overviewHtml %}
  <div class="case-layout">

    {# Progress timeline / stages #}
    {# {% include "_shared/_includes/case/details/progress-panel.njk" %} #}

    <p class="govuk-body govuk-!-margin-bottom-0">Case complexity: <span class="govuk-!-font-weight-bold">Basic</span></p>
    <p class="govuk-body govuk-!-margin-bottom-0">Case status: <span class="govuk-!-font-weight-bold">Pre-charge</span></p>
    
    {% set childDefendants = [] %}
    {% for defendant in _case.defendants %}
      {% if defendant.dateOfBirth and (defendant.dateOfBirth | age) < 18 %}
        {% set childDefendants = (childDefendants.push(defendant), childDefendants) %}
      {% endif %}
    {% endfor %}

    {% if childDefendants.length > 0 %}
      {% set childDefendantsValue %}
        {{ childDefendants[0].firstName }} {{ childDefendants[0].lastName }}
        {% if childDefendants.length > 1 %}
          and {{ childDefendants.length - 1 }} more
        {% endif %}
      {% endset %}

      {% if childDefendants.length > 1 %}
        {{ govukWarningText({
          html: childDefendantsValue + " are under 18 years of age, and have the legal status of children.",
          iconFallbackText: "Warning icon"
        }) }}
      {% else %}
        {{ govukWarningText({
          html: childDefendantsValue + " is under 18 years of age, and has the legal status of a child.",
          iconFallbackText: "Warning icon"
        }) }}
      {% endif %}
    {% endif %}

    {# 3-column area #}
    <div class="case-grid">
      <div class="contacts-box">
        {% include "_shared/_includes/case/details/contacts-panel.njk" %}
      </div>

      <div class="tasks-box">
        {% include "_shared/_includes/case/details/tasks-panel.njk" %}
      </div>

      <div class="monitoring-box">
        {% include "_shared/_includes/case/details/monitoring-panel.njk" %}
      </div>
    </div>
  </div>
{% endset %}


{# ---------- Other tabs ---------- #}


{% set caseOutlineHtml %}
  <h3 class="govuk-heading-m">Case outline</h3>
  {% include "_shared/_includes/case/details/outline-panels.njk" %}
{% endset -%}

{% set defendantsHtml %}
  <h3 class="govuk-heading-m">Defendants</h3>
  {% include "_shared/_includes/case/details/defendants.njk" %}
{% endset -%}

{% set witnessesHtml  %}<h3 class="govuk-heading-m">Witnesses</h3>{% endset -%}

{# Re-use the same contacts panel as Overview, but full width #}
{% set contactsHtml %}
  <div class="contacts-box contacts-box--tab">
    {% include "_shared/_includes/case/details/contacts-panel.njk" %}
  </div>
{% endset -%}


{{ govukTabs({
  id: "case-tabs",
  items: [
    { label: "Overview",   id: "overview",      panel: { html: overviewHtml } },
    { label: "Outline",    id: "case-outline",  panel: { html: caseOutlineHtml } },
    { label: "Defendants", id: "defendants",    panel: { html: defendantsHtml } },
    { label: "Witnesses",  id: "witnesses",     panel: { html: witnessesHtml } },
    { label: "Contacts",   id: "contacts",      panel: { html: contactsHtml } }
  ]
}) }}
