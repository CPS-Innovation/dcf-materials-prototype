{# _shared/_includes/case/details/defendants.njk #}


{# Plea enum → display label #}
{% set pleaLabels = {
  "NOT_GUILTY":    "Not guilty anticipated plea",
  "GUILTY":        "Guilty anticipated plea",
  "NO_PLEA":       "No plea entered",
  "NOT_INDICATED": "Not indicated"
} %}


{# ─── Defendant loop ─────────────────────────────────────────────────────── #}

{% for defendant in _case.defendants %}

  {# ── Summary card ────────────────────────────────────────────────────── #}
  <div class="govuk-summary-card">
    <div class="govuk-summary-card__title-wrapper">
      <h2 class="govuk-summary-card__title">
        {{ defendant.lastName }}, {{ defendant.firstName }}
      </h2>
    </div>

    <div class="govuk-summary-card__content">

      {# ── Sub-navigation ────────────────────────────────────────────── #}
      {{ mojSubNavigation({
        label: "Defendant sub navigation",
        items: [
          { text: "Charges",                href: "#", active: true },
          { text: "Defendant Details",       href: "#" },
          { text: "Bail & Remand",           href: "#" },
          { text: "Candidate Court Orders",  href: "#" },
          { text: "Offences TIC",            href: "#" },
          { text: "Associated Cases",        href: "#" }
        ]
      }) }}

      {# ── Charges table ─────────────────────────────────────────────── #}
      {#
        govukTable() is not used here because each charge needs a paired hidden
        detail <tr> below it — a pattern the macro cannot express.
        GDS table classes are applied manually to stay consistent with the design system.
      #}
      {% if defendant.charges.length %}
        <div style="overflow-x: auto;">
        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col" style="width: 120px">Charge code</th>
              <th class="govuk-table__header" scope="col">Description and status</th>
              <th class="govuk-table__header" scope="col">Offence date</th>
              <th class="govuk-table__header" scope="col">Plea or verdict</th>
              <th class="govuk-table__header" scope="col">
                <span class="govuk-visually-hidden">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">

            {% for charge in defendant.charges %}
              {% set detailRowId = "charge-detail-" + defendant.id + "-" + charge.id %}
              {% set victim = charge.victim if charge.victim else (_case.victims[loop.index0 % _case.victims.length] if _case.victims.length else null) %}
              {% set victimStatus = "Intimidated" if loop.index0 % 2 == 0 else "Vulnerable" %}
              {% set pleaDisplay = pleaLabels[charge.plea] or charge.plea %}

              {% if victim %}
                {% set victimCellHtml %}{{ victim.firstName }} {{ victim.lastName }}{% endset %}
                {% set victimStatusHtml %}<strong class="govuk-tag govuk-tag--blue govuk-!-margin-top-1">{{ victimStatus }}</strong>{% endset %}
              {% else %}
                {% set victimCellHtml %}<span class="govuk-hint">Not recorded</span>{% endset %}
                {% set victimStatusHtml %}<span class="govuk-hint">Not recorded</span>{% endset %}
              {% endif %}

              {# ── Main charge row ────────────────────────────────────── #}
              <tr class="govuk-table__row">

                <td class="govuk-table__cell">{{ charge.chargeCode }}</td>

                <td class="govuk-table__cell">
                  <strong>{{ charge.description }}</strong>
                  <br>
                  <strong class="govuk-tag {{ 'govuk-tag--yellow' if charge.status === 'Discontinued' else 'govuk-tag--blue' }} govuk-!-margin-top-1">
                    {{ charge.status }}
                  </strong>
                </td>

                <td class="govuk-table__cell">
                  {{ charge.offenceDate | date("D/M/YYYY") }}
                </td>

                <td class="govuk-table__cell">{{ pleaDisplay }}</td>

                <td class="govuk-table__cell govuk-table__cell--numeric">
                  <a href="#"
                     class="govuk-link js-charge-toggle"
                     data-target="{{ detailRowId }}"
                     aria-expanded="false"
                     aria-controls="{{ detailRowId }}">
                    Show
                    <span class="govuk-visually-hidden">
                      details for {{ charge.chargeCode }} {{ charge.description }}
                    </span>
                  </a>
                </td>

              </tr>

              {# ── Detail row — hidden by default ─────────────────────── #}
              <tr class="govuk-table__row" id="{{ detailRowId }}" hidden>
                <td class="govuk-table__cell" colspan="5">

                    {% if victim %}
                      {% set resolvedParticulars = charge.particulars
                        | replace("[defendant]", defendant.firstName + " " + defendant.lastName)
                        | replace("[victim]", victim.firstName + " " + victim.lastName) %}
                    {% else %}
                      {% set resolvedParticulars = charge.particulars
                        | replace("[defendant]", defendant.firstName + " " + defendant.lastName) %}
                    {% endif %}

                    {{ govukSummaryList({
                      classes: "govuk-!-font-size-16 charge-detail-summary",
                      rows: [
                        {
                          classes: "govuk-summary-list__row--no-border",
                          key:     { text: "Charge particulars" },
                          value:   { text: resolvedParticulars }
                        },
                        {
                          classes: "govuk-summary-list__row--no-border",
                          key:     { text: "Victim" },
                          value:   { html: victimCellHtml }
                        },
                        {
                          classes: "govuk-summary-list__row--no-border",
                          key:     { text: "Status" },
                          value:   { html: victimStatusHtml }
                        }
                      ]
                    }) }}

                    <div class="govuk-button-group  govuk-!-margin-top-4">
                      {{ govukButton({ text: "Mark for withdrawal", classes: "govuk-button--secondary govuk-!-font-size-19" }) }}
                      {% if charge.status === "Discontinued" %}
                        <a class="govuk-link" href="/cases/{{ _case.id }}/charges/discontinue/cms?chargeId={{ charge.id }}">Prepare victim letter</a>
                        <a class="govuk-link" href="/cases/{{ _case.id }}/charges/discontinue/set-reminder-details?chargeId={{ charge.id }}">Set reminder</a>
                      {% else %}
                        {{ govukButton({ text: "Discontinue charge", href: "/cases/" + _case.id + "/charges/discontinue/index?chargeId=" + charge.id, classes: "govuk-button--secondary govuk-!-font-size-19" }) }}
                        {{ govukButton({ text: "Edit charge", href: "/cases/" + _case.id + "/charges/edit/check?chargeId=" + charge.id, classes: "govuk-button--secondary govuk-!-font-size-19" }) }}
                      {% endif %}
                    </div>

                </td>
              </tr>

            {% endfor %}

          </tbody>
        </table>
        </div>

      {% else %}
        <p class="govuk-body">No charges recorded for this defendant.</p>
      {% endif %}

      {# ── Below-table actions ──────────────────────────────────────────── #}
      {# <p class="govuk-body">
        <a href="#" class="govuk-link">Show finalised charges</a>
      </p> #}

      {{ govukButton({ text: "Add charges", classes: "govuk-button--secondary" }) }}

    </div>{# /govuk-summary-card__content #}
  </div>{# /govuk-summary-card #}

{% endfor %}


{# ─── Toggle script ───────────────────────────────────────────────────────── #}
<script>
(function () {
  document.querySelectorAll('.js-charge-toggle').forEach(function (link) {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      var detailRow = document.getElementById(this.getAttribute('data-target'));
      var isOpen    = this.getAttribute('aria-expanded') === 'true';

      detailRow.hidden = isOpen;
      this.setAttribute('aria-expanded', String(!isOpen));
      this.firstChild.textContent = isOpen ? 'Show ' : 'Hide ';
    });
  });
})();
</script>
