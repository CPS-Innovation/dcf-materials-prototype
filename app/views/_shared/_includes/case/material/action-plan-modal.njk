<div class="dcf-action-plan-modal" id="dcf-action-plan-modal" hidden>
  <div class="dcf-action-plan-modal__overlay" data-action="close-action-plan"></div>

  <aside
    class="dcf-action-plan-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dcf-action-plan-modal-title"
  >
    <header class="dcf-action-plan-modal__header">
      <h2 class="govuk-heading-m" id="dcf-action-plan-modal-title">
        Action plan
      </h2>

      <button
        type="button"
        class="dcf-action-plan-modal__close"
        data-action="close-action-plan"
      >
        <span class="govuk-visually-hidden">Close action plan</span>
        ✕
      </button>
    </header>

    <div class="dcf-action-plan-modal__body">
      <div class="dcf-action-plan-modal__heading-group">
        {# <h2 class="govuk-heading-m govuk-!-margin-bottom-1">Actions</h2> #}
        <h3 class="govuk-heading-s govuk-!-margin-bottom-0">Police initiated actions</h3>
      </div>

      <div class="dcf-action-plan-modal__cards">
        {% set actionPlanSection = "police-initiated" %}
        {% for action in actionPlanItems %}
          {% include "_shared/_includes/case/material/action-plan-card.njk" %}
          {# {% include "_shared/_includes/case/material/action-plan-list.njk" %} #}
        {% endfor %}
      </div>

      <div class="dcf-action-plan-modal__heading-group">
        <h3 class="govuk-heading-s govuk-!-margin-bottom-0">Triage and pre-charge actions</h3>
      </div>

      <div class="dcf-action-plan-modal__cards">
        {% set actionPlanSection = "triage-pre-charge" %}
        {% for action in triagePreChargeItems %}
          {% include "_shared/_includes/case/material/action-plan-card.njk" %}
          {# {% include "_shared/_includes/case/material/action-plan-list.njk" %} #}
        {% endfor %}
      </div>

      <div class="dcf-action-plan-modal__heading-group">
        <h3 class="govuk-heading-s govuk-!-margin-bottom-0">Post-charge actions</h3>
      </div>

      <div class="dcf-action-plan-modal__cards">
        {% set actionPlanSection = "post-charge" %}
        {% for action in postChargeItems %}
          {% include "_shared/_includes/case/material/action-plan-card.njk" %}
          {# {% include "_shared/_includes/case/material/action-plan-list.njk" %} #}
        {% endfor %}
      </div>
    </div>
  </aside>
</div>
