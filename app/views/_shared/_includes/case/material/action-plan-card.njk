{# -------------------------------------------------------------------------
  app/views/_shared/_includes/case/material/action-plan-card.njk

  Expected params (via the `action` loop variable set by
  action-plan-modal.njk):
    - type              : string (e.g. "ROTI") — also the card title
    - status            : string (e.g. "In progress")
    - requiredByDisplay : string (e.g. "Not Scheduled")
    - category          : string
    - relatedSuspect    : string
    - relatedMaterial   : string
    - dateChaserSent    : string (e.g. "15 September 2026")
    - reasonForUpdate   : string — can be long free text. js-action-plan-
                          reason (see action-plan-modal.js) truncates it
                          client-side to "first 3 words… Show more" and
                          expands in place to the full text with "Show
                          less" trailing it, in the same paragraph — see
                          App.TextExpander (text-expander.js) for why this
                          needed JS rather than a <details> component
                          (summary always renders before its content,
                          so a toggle that trails the full text isn't
                          achievable natively)
------------------------------------------------------------------------- #}

{% set reasonForUpdateHtml %}
  <p class="govuk-body app-action-plan-reason-preview govuk-!-margin-bottom-0 js-action-plan-reason">{{ action.reasonForUpdate }}</p>
{% endset %}

{{ govukSummaryList({
  classes: "app-summary-list--small-text",
  card: {
    classes: "app-action-plan-card",
    title: {
      text: action.type,
      headingLevel: 3
    },
    actions: {
      classes: "app-action-plan-card__actions",
      items: [
        { href: "#", text: "Complete action", visuallyHiddenText: action.type },
        { href: "#", text: "Withdraw", visuallyHiddenText: action.type }
      ]
    }
  },
  rows: [
      { key: { text: "Status" }, value: { text: action.status } },
      {
        key: { text: "Required by" },
        value: { text: action.requiredByDisplay },
        actions: {
          items: [
            { href: "#", text: "Change", visuallyHiddenText: "date required by for " + action.type }
          ]
        }
      },
      {
        key: { text: "Chaser task" },
        value: { text: action.dateChaserSent },
        actions: {
          items: [
            { href: "#", text: "Mark as complete", visuallyHiddenText: "chaser task for " + action.type }
          ]
        }
      },
      { key: { text: "Category" }, value: { text: action.category } },
      { key: { text: "Related suspect" }, value: { text: action.relatedSuspect } },
      { key: { text: "Related material" }, value: { text: action.relatedMaterial } },
      {
        key: { text: "Reason for CPS last update" },
        value: { html: reasonForUpdateHtml },
        actions: {
          items: [
            { href: "#", text: "Mark as read", visuallyHiddenText: "reason for CPS last update for " + action.type }
          ]
        }
      }
    ]
  }) }}
