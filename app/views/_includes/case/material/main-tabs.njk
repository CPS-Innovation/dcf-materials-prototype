{# _includes/case/material/main-tabs.njk #}

{% set cm = caseMaterials or data.caseMaterials or {} %}
{% set totalCount = (cm.Material or []) | length %}

{% set reviewAndRedactMaterialsHtml %}
  {% include "_includes/case/material/material-panel.njk" %}
{% endset -%}

{% set viewMaterialsLabel = "Review and redact (" ~ totalCount ~ ")" %}

{% set disclosureHtml %}
  <div class="govuk-!-width-two-thirds">
    {% include "_includes/case/disclosure/disclosure-task-list.njk" %}
  </div>
{% endset -%}

{% set communicationsHtml %}
  <h3 class="govuk-heading-m">Communications</h3>
{% endset -%}

{# Define the three tab objects once #}
{% set tabViewMaterials = {
  label: viewMaterialsLabel,
  id: "view-materials",
  panel: { html: reviewAndRedactMaterialsHtml }
} %}

{% set tabDisclosure = {
  label: "Disclosure",
  id: "disclosure",
  panel: { html: disclosureHtml }
} %}

{% set tabCommunications = {
  label: "Communications",
  id: "communications",
  panel: { html: communicationsHtml }
} %}

{# Reorder tabs so the requested one is FIRST (GOV.UK Tabs default) #}
{% if activeTab == 'disclosure' %}
  {% set tabItems = [tabDisclosure, tabViewMaterials, tabCommunications] %}
{% elif activeTab == 'communications' %}
  {% set tabItems = [tabDisclosure, tabViewMaterials, tabCommunications] %}
{% else %}
  {% set tabItems = [tabDisclosure, tabViewMaterials, tabCommunications] %}
{% endif %}

{{ govukTabs({
  id: "case-tabs",
  items: tabItems
}) }}