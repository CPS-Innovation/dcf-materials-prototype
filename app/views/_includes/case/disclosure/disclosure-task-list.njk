{# _includes/case/disclosure/disclosure-task-list.njk  #}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}


{# {% set cm = data.caseMaterials or {} %} #}
{% set cm = caseMaterials or data.caseMaterials or {} %}
{% set materials = cm.Material or [] %}
{% set firstMaterial = materials | first %}

{% set progressTagClass = {
  "Not started yet": "govuk-tag--blue",
  "In progress": "govuk-tag--light-blue"
} %}


{% set nonSensitiveStatus = cm.cpsDisclosureAssessment.hasAssessedNonSensitive or "Not started yet" %}


    <h2 class="govuk-heading-l">Disclosure</h2>
    <p class="govuk-body">Check or complete the assessment of unused case materials</p>

    <div class="app-list">
      <div class="app-list__item">
        
        <h3 class="govuk-heading-m">Police certification</h3>

        {{ govukSummaryList({
          classes: "govuk-summary-list--no-border govuk-!-margin-bottom-6",
          rows: [
            {
              key: { text: "Date of certification" },
              value: { text: cm.policeDisclosureCertification.dateOfCertification }
            },
            {
              key: { text: "Disclosing officer name" },
              value: { text: cm.policeDisclosureCertification.disclosingOfficerName }
            }
          ]
        }) }}

        {{ govukDetails({
          summaryText: "Show certification",
          html: cm.policeDisclosureCertification.certifierComment | replace('\n', '<br>')| safe
        }) }}

      </div>
    </div>


    <h3 class="govuk-heading-m govuk-!-margin-bottom-6">CPS disclosure assessment</h3>

      {% set nonSensitiveStatus = cm.cpsDisclosureAssessment.hasAssessedNonSensitive or "Not started yet" %}
      {% set sensitiveStatus = cm.cpsDisclosureAssessment.hasAssessedSensitive or "Not started yet" %}

      {% set nonSensitiveStatusHtml %}
        {% if nonSensitiveStatus == "Completed" %}
          <span class="govuk-body govuk-!-margin-0">Completed</span>
        {% else %}
          <strong class="govuk-tag {{ progressTagClass[nonSensitiveStatus] or 'govuk-tag--grey' }}">
            {{ nonSensitiveStatus }}
          </strong>
        {% endif %}
      {% endset %}

      {% set sensitiveStatusHtml %}
        {% if sensitiveStatus == "Completed" %}
          <span class="govuk-body govuk-!-margin-0">Completed</span>
        {% else %}
          <strong class="govuk-tag {{ progressTagClass[sensitiveStatus] or 'govuk-tag--grey' }}">
            {{ sensitiveStatus }}
          </strong>
        {% endif %}
      {% endset %}

  
      {# TEMP: TOGGLE true OR false to simulate sensitive completion for demo purposes #}
      {% set simulateSensitiveCompleted = true %}

      {% if simulateSensitiveCompleted %}
        {% set sensitiveStatus = "Completed" %}
        {# TODO: remove once assess-sensitive routes are implemented #}
        {% set sensitiveStatusHtml %}
          <span class="govuk-body govuk-!-margin-0">Completed</span>
        {% endset %}
      {% endif %}



      {# --- Disagreement flags (from rows) --- #}
      {% set nsRows = data.disclosureNonSensitiveRows or [] %}


      {# --- Police "No longer relevant" flags (from rows) --- #}
      {% set nlrRows = [] %}

      {% for r in nsRows %}
        {% if r and ((r.policeAssessment or '') | lower == 'no longer relevant') %}
          {% set _ = nlrRows.push(r) %}
        {% endif %}
      {% endfor %}

      {% set hasPoliceNoLongerRelevant = (nlrRows.length > 0) %}


      {# Nunjucks-safe: mutate an array (push) so state persists across the loop #}
      {% set disagreements = [] %}

      {% for r in nsRows %}
        {% if r and r.cpsDisagreesWithPolice %}
          {% set _ = disagreements.push(true) %}
        {% endif %}
      {% endfor %}

      {% set hasAnyDisagreement = (disagreements.length > 0) %}

      {# While sensitive isn’t built yet, only gate on non-sensitive completion #}
      {% set nonSensitiveCompleted = (nonSensitiveStatus == "Completed") %}

      {# --- Inset messaging --- #}
      {# ✅ NEW: Police have marked items as "No longer relevant" #}
      {% if hasPoliceNoLongerRelevant %}

        {% set disclosureReturnUrl = ("/cases/" ~ _case.id ~ "/material?tab=disclosure") | urlencode %}
        {% set nlrHref = "/cases/" ~ _case.id ~ "/disclosure/no-longer-relevant?returnUrl=" ~ disclosureReturnUrl %}

        {{ govukInsetText({
          html:
            "The police have assessed one or more items as no longer relevant as part of splitting or merging this case.<br><br>" ~
            "You need to <a class='govuk-link' href='" ~ nlrHref ~ "'>review material that is no longer relevant</a> and either agree that the items are no longer relevant or ask the police to reinstate them."
        }) }}

      {% endif %}




      {# --- Sign and export schedule status --- #}
      {% set signExportStatusHtml %}
        <strong class="govuk-tag govuk-tag--blue">Not completed</strong>
      {% endset %}


      {# --- Build task list items dynamically --- #}
      {% set taskItems = [] %}

      {% set _ = taskItems.push({
        title: { text: "Assess non-sensitive materials" },
        hint: { text: "Complete disclosure for all unused non-sensitive items" },
        href: "/cases/" ~ _case.id ~ "/disclosure/assess-non-sensitive",
        status: { html: nonSensitiveStatusHtml }
      }) %}

      {% set _ = taskItems.push({
        title: { text: "Assess sensitive materials" },
        hint: { text: "Complete disclosure for all unused sensitive items" },
        href: "/cases/" ~ _case.id ~ "/disclosure/assess-sensitive",
        status: { html: sensitiveStatusHtml }
      }) %}

      {# ✅ Append ONLY when completed + agreement #}
      {% if nonSensitiveCompleted and (not hasAnyDisagreement) %}
        {% set _ = taskItems.push({
          title: {
            html: '<a class="govuk-link" href="#">Sign and export the disclosure schedules</a>'
          },
          status: {
            html: '<strong class="govuk-tag govuk-tag--blue">Not completed</strong>'
          }
        }) %}
      {% endif %}


      {{ govukTaskList({
        idPrefix: "assess-disclosure-tasks",
        classes: "govuk-summary-list--no-border",
        items: taskItems
      }) }}





