{# MoJ Multi-select: checkbox | Item | Title | Description | Police assessment | Police rationale | Rebuttable | CPS assessment | Actions #}

{% set bodyClasses = "dcf-materials-wide" %}

{% set singleRowActions %}
  {{ mojButtonMenu({
    classes: "dcf-button-menu--as-link",
    button: { text: "Actions" },
    items: [
      { text: "Assess as disclosable" },
      { text: "Assess as disclosable by inspection" },
      { text: "Assess as clearly not disclosable" },
      { text: "Assess as not disclosable" },
      { text: "Assess as evidence" },
      { text: "Dispute sensitivity" },
      { text: "Request material" },
      { text: "Request updated description" }
    ]
  }) }}
{% endset %}

<table class="govuk-table" data-module="moj-multi-select" data-id-prefix="materials-">
  <thead class="govuk-table__head govuk-body-s">
    <tr class="govuk-table__row">
      <th class="govuk-table__header" scope="col" id="materials-select-all"></th>
      <th class="govuk-table__header" scope="col">Item</th>
      <th class="govuk-table__header" scope="col">Title</th>
      <th class="govuk-table__header" scope="col">Description</th>
      <th class="govuk-table__header" scope="col">Police assessment</th>
      <th class="govuk-table__header" scope="col">Police rationale</th>
      <th class="govuk-table__header" scope="col">Rebuttable</th>
      <th class="govuk-table__header" scope="col">Exceptions</th>
      <th class="govuk-table__header" scope="col">CPS assessment</th>
      <th class="govuk-table__header" scope="col">Actions</th>
    </tr>
  </thead>

  <tbody class="govuk-table__body govuk-body-s">
    {% set rows = [
      {
        id: '01',
        item: '01',
        title: 'Exh SP/1',
        description: 'DA History for Ella Quagmire. This is a compilation of all the domestic abuse reports which the victim has been involved in. The reports have been taken from the police system iOPS. This document contains a total of 17 pages and is redacted as per redaction guidelines.',
        policeAssessment: 'Passes disclosure test',
        policeRationale: 'Reason material passes test here',
        isRebuttable: 'No',
        hasException: null,
        exceptionReason: null,
        cpsAssessment: 'To be assessed',
        rowActions: singleRowActions
      },
      {
        id: '02',
        item: '02',
        title: 'Exh SP/2',
        description: 'DA History for Elton Berkley. This is a compilation of all the domestic abuse reports which the defendant has been involved in. The reports have been taken from the police system iOPS. This document contains a total of 4 pages and is redacted as per redaction guidelines.',
        policeAssessment: 'Fails disclosure test',
        policeRationale: 'Reason material fails test here',
        isRebuttable: 'Yes',
        hasException: 'DEESEE Frank',
        exceptionReason: 'Exception reason here if applicable',
        cpsAssessment: 'To be assessed',
        rowActions: singleRowActions
      },
      {
        id: '03',
        item: '03',
        title: 'Exh SP/3',
        description: 'PNB entry made by PC 9999 Parsons from GMP issues Pocket Notebook. This entry was made on 07/03/2025 at 1921 hours and details the house-to-house enquiries conducted. This also includes information of the victims first account and the arrest of the defendant. This document consists of a total of 2 pages.',
        policeAssessment: 'Passes disclosure test',
        policeRationale: 'Reason material passes test here',
        isRebuttable: 'No',
        hasException: null,
        exceptionReason: null,
        cpsAssessment: 'To be assessed',
        rowActions: singleRowActions
      }
    ] %}

    {% for r in rows %}
      <tr class="govuk-table__row">
        <td class="govuk-table__cell">
          <div class="govuk-checkboxes__item govuk-checkboxes--small moj-multi-select__checkbox">
            <input
              type="checkbox"
              class="govuk-checkboxes__input"
              id="materials-{{ r.id }}"
              name="selectedMaterials"
              value="{{ r.id }}"
            >
            <label class="govuk-label govuk-checkboxes__label" for="materials-{{ r.id }}">
              <span class="govuk-visually-hidden">Select item {{ r.item }}</span>
            </label>
          </div>
        </td>

        <td class="govuk-table__cell">{{ r.item }}</td>
        <td class="govuk-table__cell">{{ r.title }}</td>
        <td class="govuk-table__cell">{{ r.description }}</td>

        <td class="govuk-table__cell">
          {% set policeTagClass = "govuk-tag--grey" %}

          {% if r.policeAssessment == "Passes disclosure test" %}
            {% set policeTagClass = "govuk-tag--green" %}
          {% elseif r.policeAssessment == "Fails disclosure test" %}
            {% set policeTagClass = "govuk-tag--yellow" %}
          {% endif %}

          <strong class="govuk-tag {{ policeTagClass }} govuk-!-font-size-16">
            {{ r.policeAssessment }}
          </strong>
        </td>


        <td class="govuk-table__cell">
          {{ r.policeRationale }}
        </td>

        <td class="govuk-table__cell">{{ r.isRebuttable }}</td>

        <td class="govuk-table__cell">
          {% if r.hasException %}
            {{ r.hasException }}<br>
            <strong>Reason:</strong> {{ r.exceptionReason }}
          {% else %}
            None
          {% endif %}
        </td>


        <td class="govuk-table__cell">
          <strong class="govuk-tag govuk-tag--grey govuk-!-font-size-16">
            {{ r.cpsAssessment }}
          </strong>
        </td>

        <td class="govuk-table__cell">
          {{ r.rowActions | safe }}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
